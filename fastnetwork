def check_network(bar):
    bar.draw(0, "Checking", "network...", "43;30")
    if not has_route():
        raise Problem("NO_NETWORK")
    bar.draw(20, "Checking", "DNS...", "43;30")
    if not dns_ok(HOST):
        raise Problem("DNS") if internet_ok() else Problem("NO_INTERNET")
    bar.draw(40, "Checking", "Wi-Fi login page...", "43;30")
    if login_page():
        raise Problem("LOGIN")
    bar.draw(70, "Checking", "test server...", "43;30")
    try:
        info = server_info()
    except Exception as e:
        p = classify(e)
        if p.key in ("LOST", "BLOCKED") and HTTPS:
            p = Problem("BLOCKED", p.detail) if internet_ok() else Problem("NO_INTERNET")
        raise p
    bar.draw(100, "Checking", "ok", "43;30")
    return info


def measure_ping(bar, count):
    times, fails, conn, last_err = [], 0, None, None
    for i in range(count):
        try:
            if conn is None:
                conn = connect(3)
                ping(conn)  # warm up (connection + TLS), not counted
            times.append(ping(conn))
        except HttpError as e:
            raise classify(e)
        except Exception as e:
            fails += 1
            last_err = e
            close(conn)
            conn = None
        text = f"{times[-1]:.1f} ms" if times else "..."
        bar.draw((i + 1) / count * 100, "Ping", text, "44;97")
        time.sleep(0.05)
    close(conn)
    if not times:
        raise classify(last_err) if last_err else Problem("LOST")
    jitter = statistics.mean(abs(a - b) for a, b in zip(times, times[1:])) if len(times) > 1 else 0.0
    return statistics.median(times), jitter, fails / count * 100


def stalled(errors):
    """No data is moving. Decide which problem it is."""
    if errors:
        p = classify(errors[-1])
        # It worked a moment ago, so "refused" now means the connection was lost.
        if p.key in ("BUSY", "SECURE", "NO_NETWORK"):
            return p
    if not has_route():
        return Problem("NO_NETWORK")
    if not internet_ok():
        return Problem("LOST")
    if errors:
        return Problem("LOST", type(errors[-1]).__name__)
    return Problem("TOO_SLOW")


def measure_transfer(bar, label, worker, cfg, cap, color):
    counter = Counter(cap)
    stop = threading.Event()
    errors, busy = [], []
    threads = [threading.Thread(target=worker, args=(stop, counter, errors, cfg), daemon=True)
               for _ in range(cfg["conns"])]
    threads.append(threading.Thread(target=busy_ping_worker, args=(stop, busy), daemon=True))
    for t in threads:
        t.start()

    seconds, warmup = cfg["seconds"], cfg["warmup"]
    t0 = time.monotonic()
    samples = [(t0, 0)]
    start = None
    result = None
    end = None
    last_n, last_move, logged = 0, t0, 0
    try:
        while True:
            time.sleep(0.02 if cap else 0.05)
            t, n = time.monotonic(), counter.get()
            el = t - t0
            samples.append((t, n))
            if n > last_n:
                last_n, last_move = n, t

            # Skip the slow start; measure only after it.
            if start is None and (el >= warmup or (cap and n >= cap * 0.25)):
                start = (t, n)
            if start and t - start[0] > 0.05:
                result = mbps(n - start[1], t - start[0])

            old = next((s for s in samples if s[0] >= t - 1.5), samples[0])
            live = mbps(n - old[1], t - old[0])

            pct = el / seconds * 100
            if cap:
                pct = max(pct, n / cap * 100)
            avg = fmt_speed(result) if result is not None else "measuring..."
            bar.draw(min(pct, 99), label, f"{fmt_speed(live)}  (avg {avg})", color)

            if int(el) > logged:
                logged = int(el)
                bar.print(f"  {dim(f'{label:<9}{logged:>3}s')}   now {fmt_speed(live):>11}"
                          f"   avg {bold(f'{avg:>11}')}")

            # Server said "no" (too many tests, blocked...): stop now.
            http_errors = [e for e in errors if isinstance(e, HttpError)]
            if http_errors:
                raise classify(http_errors[-1])

            # Mobile limit: stop when all limited data has arrived.
            if cap and counter.sent() >= cap and n >= counter.sent():
                end = counter.done_at if not counter.socks else t
                break
            # Nothing is moving: find out why.
            if t - last_move > 6 or (n == 0 and el >= min(seconds, 8)):
                raise stalled(errors)
            if el >= seconds:
                break
    finally:
        stop.set()

    n = counter.get()
    if end and start and end - start[0] > 0.05:
        result = mbps(n - start[1], end - start[0])
    if not result:
        result = mbps(n, (end or time.monotonic()) - t0)
    bar.draw(100, label, fmt_speed(result), color)
    return result, counter.sent(), (statistics.median(busy) if busy else None)


# ----------------------------------------------------------------------------
# Words for results
# ----------------------------------------------------------------------------
def rate(value, steps, words):
    for limit, word in zip(steps, words):
        if value < limit:
            return word
    return words[-1]


def rate_down(m): return rate(m, (1, 5, 25, 100), ("Very slow", "Slow", "OK", "Fast", "Very fast"))
def rate_up(m): return rate(m, (1, 3, 10, 50), ("Very slow", "Slow", "OK", "Fast", "Very fast"))
def rate_ping(ms): return rate(ms, (20, 50, 100, 200), ("Excellent", "Good", "OK", "High", "Very high"))
def rate_jitter(ms): return rate(ms, (10, 30), ("Stable", "A little unstable", "Unstable"))


def word_color(word):
    if word in ("Very slow", "Very high", "Unstable", "Slow", "High"):
        return red(word)
    if word in ("OK", "A little unstable"):
        return yellow(word)
    return green(word)


def report(r, mode, info):
    dl, ul = r.get("down"), r.get("up")
    pg, jt, loss = r.get("ping"), r.get("jitter"), r.get("loss")
    busy = max((x for x in (r.get("busy_down"), r.get("busy_up")) if x is not None), default=None)

    line = "-" * 52
    print(line)
    if dl is not None:
        print(f"  Download     {bold(f'{fmt_speed(dl):>11}')}   {word_color(rate_down(dl))}")
    if ul is not None:
        print(f"  Upload       {bold(f'{fmt_speed(ul):>11}')}   {word_color(rate_up(ul))}")
    if pg is not None:
        print(f"  Ping         {pg:>8.0f} ms   {word_color(rate_ping(pg))}")
        print(f"  Jitter       {jt:>8.0f} ms   {word_color(rate_jitter(jt))}")
        print(f"  Lost pings   {loss:>8.0f} %")
    if busy is not None:
        print(f"  Busy ping    {busy:>8.0f} ms")
    used = (r.get("down_bytes", 0) + r.get("up_bytes", 0)) / 1e6
    print(f"  Data used    {used:>8.0f} MB")
    print(line)

    if dl is None or ul is None or pg is None:
        return  # test did not finish; problem is printed after this

    bloat = (busy - pg) if busy is not None else 0
    checks = [
        ("Web, email, music", dl >= 1),
        ("HD video (1080p)", dl >= 5),
        ("4K video", dl >= 25),
        ("Video calls", dl >= 3 and ul >= 1.5 and pg < 150 and jt < 30 and loss < 5),
        ("Online games", dl >= 3 and pg < 60 and jt < 20 and loss == 0 and bloat < 100),
        ("Sending big files", ul >= 10),
    ]
    print("  What works here:")
    for name, ok in checks:
        print(f"    {green('YES') if ok else red('NO ')}  {name}")

    oks = dict(checks)
    if oks["Online games"] and oks["4K video"]:
        status = green("EXCELLENT") + " - Everything works well."
    elif oks["Video calls"] and oks["HD video (1080p)"]:
        status = green("GOOD") + " - Good for work, calls and video."
    elif oks["Web, email, music"]:
        status = yellow("BASIC") + " - OK for web and email. Calls and video may have problems."
    else:
        status = red("POOR") + " - The internet is very slow here."
    print(line)
    print(f"  Status: {status}")

    notes = []
    if loss > 0:
        notes.append(f"{loss:.0f}% of pings did not come back. The connection drops sometimes.")
    if jt >= 30:
        notes.append("Ping changes a lot. Calls may freeze.")
    if bloat >= 100:
        notes.append("When the internet is busy, it becomes slow to answer. Calls lag if someone downloads.")
    if pg >= 150:
        notes.append("Ping is high. Everything feels a little late.")
    if info.get("trace_warp", "off") != "off" or "cloudflare" in str(info.get("asOrganization", "")).lower():
        notes.append("You may be using a VPN. These results show the VPN speed.")
    if mode == "mobile":
        notes.append("Mobile mode: short test, results are a little less exact.")
    for n in notes:
        print(f"  {yellow('!')} {n}")


def show_problem(p):
    code, title, what, todo = PROBLEMS[p.key]
    print()
    print(f"  {red(bold('PROBLEM: ' + title))}  {dim(f'(exit code {code})')}")
    print(f"  {what}")
    if p.detail:
        print(f"  {dim('Detail: ' + str(p.detail))}")
    print(f"  {bold('What to do:')} {todo}")
    return code


