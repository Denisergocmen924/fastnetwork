THE TEST IS THE SAME EVERY TIME
  1. Check the network (Wi-Fi, DNS, login page, test server)
  2. Ping: 20 times            (mobile: 10 times)
  3. Download: 10 seconds      (mobile: max 10 MB)
  4. Upload: 10 seconds        (mobile: max 3 MB)
  Test server: speed.cloudflare.com (the closest one to you)
  A normal test can use a lot of data on fast internet
  (about 250 MB if download and upload are both 100 Mbps).
  Use --mobile on mobile data.

RESULTS
  Download     How fast you GET data. Websites, videos and files use it.
               Bigger is better. Mbps = megabits per second.
  Upload       How fast you SEND data. Video calls and sending files use it.
               Bigger is better.
  Ping         Time for a small message to go and come back.
               Smaller is better. ms = milliseconds (1000 ms = 1 second).
  Jitter       How much the ping changes. Smaller is better.
               Big jitter = calls and games are not smooth.
  Lost pings   Pings that did not come back. 0 % is best.
  Busy ping    Ping while the internet is busy (during the test).
               If it is much bigger than Ping, calls lag when
               someone downloads something.
  Data used    How much internet data the test used.

WORDS
  Download (Mbps):  under 1 Very slow | 1-5 Slow | 5-25 OK | 25-100 Fast | 100+ Very fast
  Upload (Mbps):    under 1 Very slow | 1-3 Slow | 3-10 OK | 10-50 Fast  | 50+ Very fast
  Ping (ms):        under 20 Excellent | 20-50 Good | 50-100 OK | 100-200 High | 200+ Very high
  Jitter (ms):      under 10 Stable | 10-30 A little unstable | 30+ Unstable

STATUS
  EXCELLENT    Everything works well, also games and 4K video.
  GOOD         Good for work, video calls and HD video.
  BASIC        OK for web and email. Calls and video may have problems.
  POOR         The internet is very slow.

PROBLEMS AND EXIT CODES
  0    OK                    The test finished.
{problems}
  130  CANCELLED             You pressed Ctrl+C.
"""


def help_text():
    rows = []
    for code, title, what, _ in sorted(PROBLEMS.values()):
        rows.append(f"  {code:<4} {title:<21} {what}")
    return HELP.format(problems="\n".join(rows))


def main():
    args = sys.argv[1:]
    if any(a in ("-h", "--help") for a in args):
        print(help_text(), end="")
        return 0
    bad = [a for a in args if a not in ("--mobile", "-m")]
    if bad:
        return show_problem(Problem("WRONG_OPTION", " ".join(bad)))
    mode = "mobile" if args else "normal"
    cfg = MODES[mode]

    bar = BottomBar()
    results, info = {}, {}

    def on_signal(*_):
        raise KeyboardInterrupt

    signal.signal(signal.SIGTERM, on_signal)

    bar.start()
    try:
        bar.print(bold("fastnetwork") + dim(f"  ({mode} test)"))
        info = check_network(bar)
        where = ", ".join(x for x in (info.get("city"), info.get("country") or info.get("trace_loc")) if x)
        isp = info.get("asOrganization")
        server = info.get("colo") or info.get("trace_colo") or HOST
        ip = info.get("clientIp") or info.get("trace_ip")
        parts = [p for p in (isp, where, f"server {server}", f"IP {ip}" if ip else None) if p]
        bar.print(dim("  " + "  |  ".join(parts)))
        bar.print()

        pg, jt, loss = measure_ping(bar, cfg["pings"])
        results.update(ping=pg, jitter=jt, loss=loss)
        bar.print(f"  {cyan('Ping')}     {pg:.0f} ms   jitter {jt:.0f} ms   lost {loss:.0f} %")
        bar.print()

        bar.print(f"  {green('Download')}")
        dl, db, bd = measure_transfer(bar, "Download", download_worker, cfg, cfg["down_cap"], "42;30")
        results.update(down=dl, down_bytes=db, busy_down=bd)
        bar.print()

        bar.print(f"  {green('Upload')}")
        ul, ub, bu = measure_transfer(bar, "Upload", upload_worker, cfg, cfg["up_cap"], "44;97")
        results.update(up=ul, up_bytes=ub, busy_up=bu)
        bar.print()
    except KeyboardInterrupt:
        bar.stop()
        print("\n  Cancelled.")
        return EXIT_CANCELLED
    except BrokenPipeError:
        raise
    except Exception as e:
        bar.stop()
        if results:
            report(results, mode, info)
        return show_problem(classify(e))

    bar.stop()
    report(results, mode, info)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.stdout.write("\033[r\033[?25h" if sys.stdout.isatty() else "")
        print("\n  Cancelled.")
        sys.exit(EXIT_CANCELLED)
    except BrokenPipeError:
        # Output was closed (for example: fastnetwork | head). Exit quietly.
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        sys.exit(0)
