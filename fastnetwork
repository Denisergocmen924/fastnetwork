# ----------------------------------------------------------------------------
# Status bar fixed at the bottom of the terminal (same method as apt)
# ----------------------------------------------------------------------------
class BottomBar:
    def __init__(self):
        self.on = False
        self.rows = 0
        self.last = None
        self.lock = threading.Lock()

    def start(self):
        if not sys.stdout.isatty():
            return
        cols, rows = shutil.get_terminal_size((80, 24))
        if rows < 5 or cols < 40:
            return  # terminal too small: no bar, plain text only
        self.rows = rows
        # Make room, keep the last line out of the scroll area, hide cursor.
        sys.stdout.write("\n\0337\033[1;%dr\0338\033[1A\033[?25l" % (rows - 1))
        sys.stdout.flush()
        self.on = True
        try:
            signal.signal(signal.SIGWINCH, self._resized)
        except (AttributeError, ValueError):
            pass

    def _resized(self, *_):
        with self.lock:
            if not self.on:
                return
            self.rows = shutil.get_terminal_size((80, 24)).lines
            sys.stdout.write("\0337\033[1;%dr\0338" % (self.rows - 1))
            sys.stdout.flush()
        if self.last:
            self.draw(*self.last)

    def draw(self, percent, label, text, color="42;30"):
        self.last = (percent, label, text, color)
        if not self.on:
            return
        with self.lock:
            cols = shutil.get_terminal_size((80, 24)).columns
            left = f"{label}: [{int(percent):3d}%]"
            right = f" {text}"
            width = cols - len(left) - len(right) - 4
            bar = ""
            if width >= 10:
                full = int(width * min(max(percent, 0), 100) / 100)
                bar = " [" + "#" * full + "." * (width - full) + "]"
            line = f"\033[{color}m{left}\033[0m{bar}\033[1m{right}\033[0m"
            sys.stdout.write("\0337\033[%d;1H\033[2K%s\0338" % (self.rows, line))
            sys.stdout.flush()

    def print(self, text=""):
        with self.lock:
            sys.stdout.write(text + "\n")
            sys.stdout.flush()

    def stop(self):
        with self.lock:
            if not self.on:
                return
            sys.stdout.write("\0337\033[r\0338\0337\033[%d;1H\033[2K\0338\033[?25h" % self.rows)
            sys.stdout.flush()
            self.on = False


# ----------------------------------------------------------------------------
# Errors
# ----------------------------------------------------------------------------
class Problem(Exception):
    def __init__(self, key, detail=None):
        super().__init__(key)
        self.key = key
        self.detail = detail


class HttpError(Exception):
    def __init__(self, status):
        super().__init__(f"HTTP {status}")
        self.status = status


def classify(e):
    """Turn any error into one of the known problems."""
    if isinstance(e, Problem):
        return e
    if isinstance(e, HttpError):
        if e.status == 429 or e.status >= 500:
            return Problem("BUSY", f"HTTP {e.status}")
        return Problem("BLOCKED", f"HTTP {e.status}")
    if isinstance(e, ssl.SSLCertVerificationError):
        msg = str(e).lower()
        if "expired" in msg or "not yet valid" in msg:
            return Problem("SECURE", "Your computer's date or time is probably wrong.")
        return Problem("SECURE", "The certificate is not trusted. The network may be changing your traffic.")
    if isinstance(e, ssl.SSLError):
        return Problem("SECURE", getattr(e, "reason", None) or str(e))
    if isinstance(e, socket.gaierror):
        return Problem("DNS")
    if isinstance(e, ConnectionRefusedError):
        return Problem("BLOCKED", "Connection refused")
    if isinstance(e, OSError) and e.errno in (errno.ENETUNREACH, errno.ENETDOWN):
        return Problem("NO_NETWORK")
    return Problem("LOST", type(e).__name__)


# ----------------------------------------------------------------------------
# Network helpers
# ----------------------------------------------------------------------------
_u = urlsplit(SERVER)
HOST, PORT, PATH = _u.hostname, _u.port, _u.path.rstrip("/")
HTTPS = _u.scheme == "https"
SSL_CTX = ssl.create_default_context() if HTTPS else None


def connect(timeout=10, sndbuf=None):
    if HTTPS:
        c = http.client.HTTPSConnection(HOST, PORT, timeout=timeout, context=SSL_CTX)
    else:
        c = http.client.HTTPConnection(HOST, PORT, timeout=timeout)
    c.connect()
    if sndbuf:
        # Small send buffer: mobile mode does not send more than needed.
        c.sock.setsockopt(socket.SOL_SOCKET, socket.SO_SNDBUF, sndbuf)
    return c


def close(c):
    try:
        if c:
            c.close()
    except Exception:
        pass


def has_route():
    """Is there any network at all? (No packet is sent.)"""
    for fam, ip in ((socket.AF_INET, "1.1.1.1"), (socket.AF_INET6, "2606:4700:4700::1111")):
        try:
            with socket.socket(fam, socket.SOCK_DGRAM) as s:
                s.connect((ip, 53))
                return True
        except OSError:
            pass
    return False


def tcp_ok(fam, addr, timeout=3):
    try:
        with socket.socket(fam, socket.SOCK_STREAM) as s:
            s.settimeout(timeout)
            s.connect(addr)
            return True
    except OSError:
        return False


def internet_ok():
    """Can we reach the internet by IP address (without DNS)?"""
    return (tcp_ok(socket.AF_INET, ("1.1.1.1", 443))
            or tcp_ok(socket.AF_INET6, ("2606:4700:4700::1111", 443)))


def dns_ok(host, timeout=5):
    box = {}

    def run():
        try:
            box["ok"] = socket.getaddrinfo(host, 443, type=socket.SOCK_STREAM)
        except Exception:
            pass

    t = threading.Thread(target=run, daemon=True)
    t.start()
    t.join(timeout)
    return "ok" in box


def login_page():
    """Wi-Fi login pages change this answer (it should be 204 No Content)."""
    try:
        c = http.client.HTTPConnection(PORTAL_CHECK[0], 80, timeout=5)
        c.request("GET", PORTAL_CHECK[1], headers=HEADERS)
        r = c.getresponse()
        r.read(4096)
        c.close()
        return r.status != 204
    except Exception:
        return False  # cannot tell; continue


def get(conn, path):
    conn.request("GET", PATH + path, headers=HEADERS)
    r = conn.getresponse()
    body = r.read()
    if r.status != 200:
        raise HttpError(r.status)
    return r, body


def server_info():
    conn = connect(8)
    try:
        info = {}
        try:
            _, body = get(conn, "/meta")
            info = json.loads(body)
        except (ValueError, HttpError) as e:
            if isinstance(e, HttpError) and (e.status == 429 or e.status >= 500):
                raise
        try:
            _, body = get(conn, "/cdn-cgi/trace")
            for line in body.decode(errors="replace").splitlines():
                k, _, v = line.partition("=")
                info.setdefault("trace_" + k, v)
        except (ValueError, HttpError):
            pass
        return info
    finally:
        close(conn)


def ping(conn):
    """One tiny request. Returns round trip time in ms (server work removed)."""
    t = time.perf_counter()
    r, _ = get(conn, "/__down?bytes=0")
    ms = (time.perf_counter() - t) * 1000
    st = r.getheader("Server-Timing") or ""
    if "dur=" in st:
        try:
            ms -= float(st.split("dur=")[1].split(",")[0].split(";")[0])
        except ValueError:
            pass
    return max(ms, 0.0)


def queued(sock):
    """Bytes we sent that the server has not received yet."""
    try:
        if sys.platform.startswith("linux"):
            import fcntl
            import termios
            return struct.unpack("i", fcntl.ioctl(sock.fileno(), termios.TIOCOUTQ, b"\0" * 4))[0]
        if sys.platform == "darwin":
            return sock.getsockopt(socket.SOL_SOCKET, 0x1024)  # SO_NWRITE
    except Exception:
        pass
    return 0


class Counter:
    def __init__(self, cap):
        self.n = 0
        self.cap = cap
        self.done_at = None
        self.socks = set()  # upload sockets
        self.lock = threading.Lock()

    def add(self, k):
        """Returns True when the data limit (mobile mode) is reached."""
        with self.lock:
            self.n += k
            if self.cap and self.n >= self.cap:
                if self.done_at is None:
                    self.done_at = time.monotonic()
                return True
            return False

    def sent(self):
        with self.lock:
            return self.n

    def get(self):
        """Bytes that really arrived (for upload: minus bytes still waiting)."""
        n = self.sent()
        for s in list(self.socks):
            n -= queued(s)
        return max(n, 0)


def mbps(nbytes, seconds):
    return nbytes * 8 / seconds / 1e6 if seconds > 0 else 0.0


def fmt_speed(m):
    if m is None:
        return "-"
    if m >= 1000:
        return f"{m / 1000:.2f} Gbps"
    if m >= 100:
        return f"{m:.0f} Mbps"
    return f"{m:.1f} Mbps"


# ----------------------------------------------------------------------------
# Workers
# ----------------------------------------------------------------------------
def download_worker(stop, counter, errors, cfg):
    conn = None
    while not stop.is_set():
        try:
            if conn is None:
                conn = connect()
            conn.request("GET", f"{PATH}/__down?bytes={cfg['down_req']}", headers=HEADERS)
            r = conn.getresponse()
            if r.status != 200:
                r.read()
                raise HttpError(r.status)
            while not stop.is_set():
                b = r.read(CHUNK)
                if not b:
                    break
                if counter.add(len(b)):
                    stop.wait()  # data limit reached: stop reading
            if stop.is_set():
                break
        except Exception as e:
            errors.append(e)
            close(conn)
            conn = None
            stop.wait(0.5)
    close(conn)


UPLOAD_DATA = os.urandom(CHUNK)


def upload_worker(stop, counter, errors, cfg):
    conn = None
    size = cfg["up_req"]
    while not stop.is_set():
        try:
            if conn is None:
                conn = connect(sndbuf=cfg["sndbuf"])
                counter.socks.add(conn.sock)
            conn.putrequest("POST", PATH + "/__up")
            for k, v in HEADERS.items():
                conn.putheader(k, v)
            conn.putheader("Content-Type", "application/octet-stream")
            conn.putheader("Content-Length", str(size))
            conn.endheaders()
            left = size
            while left > 0 and not stop.is_set():
                n = min(CHUNK, left)
                conn.send(UPLOAD_DATA[:n])
                left -= n
                if counter.add(n):
                    stop.wait()  # data limit reached: let the rest arrive
            if stop.is_set():
                break
            r = conn.getresponse()
            r.read()
            if r.status != 200:
                raise HttpError(r.status)
        except Exception as e:
            errors.append(e)
            if conn:
                counter.socks.discard(conn.sock)
            close(conn)
            conn = None
            stop.wait(0.5)
    if conn:
        counter.socks.discard(conn.sock)
    close(conn)


def busy_ping_worker(stop, results):
    conn = None
    while not stop.is_set():
        try:
            if conn is None:
                conn = connect(3)
                ping(conn)  # first one includes the handshake; skip it
            results.append(ping(conn))
        except Exception:
            close(conn)
            conn = None
        stop.wait(0.4)
    close(conn)


